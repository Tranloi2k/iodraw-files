        <mxCell id="y5Lyuti5-sXJMIkNpJVW-4" value="API&lt;div&gt;post API:&lt;br&gt;POST /api/v1/post&lt;/div&gt;&lt;div&gt;GET /api/v1/post/{userId}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;newFeed API:&lt;br&gt;GET /api/v1/newfeed/{limit}&amp;amp;{cursor}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;follow API&lt;/div&gt;&lt;div&gt;GET api/v1/followers&lt;/div&gt;&lt;div&gt;POST api/v1/followers&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;" vertex="1" parent="1">
