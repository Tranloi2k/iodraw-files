        <mxCell id="y5Lyuti5-sXJMIkNpJVW-7" value="Metrix&lt;div&gt;User: 1B&lt;/div&gt;&lt;div&gt;DAU: 10M&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;avg write post / user / day:&amp;nbsp; 1&lt;/div&gt;&lt;div&gt;avg read post / user / day : 20&lt;/div&gt;&lt;div&gt;peak 10x&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;avg post size: 2KB text + 300KB media&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;write /day :&lt;span style=&quot;background-color: initial;&quot;&gt;10M&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&amp;nbsp;QPS = 10M/(24*60*60) = ~ 115&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;QPS at peak = 1150&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;read / day 20 * 10M = 200M&lt;/div&gt;&lt;div&gt;QPS = 200M/(24*60*60) = ~2000&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;QPSat peak = 20K&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;storage:&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;anual growth DB = 10M * 2KB * 365 = 7*10^9 KB = 7TB&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;10Y db = 70TB&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;anual grownth media storage&amp;nbsp; = 10M * 300KB * 365 = 10^12 kB&lt;/div&gt;&lt;div&gt;&amp;nbsp;= 1PB&lt;/div&gt;&lt;div&gt;10y&amp;nbsp; = 10PB&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;graph DB&amp;nbsp; = 2bytes * 10^9 = 2GB&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;indexing Db =&amp;nbsp; 40% * 70TP = 30 TP&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;" vertex="1" parent="1">
