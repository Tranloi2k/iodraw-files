        <mxCell id="L3YlKu59HzU1ORrmf3q_-1" value="&lt;h1 style=&quot;text-align: justify; margin-top: 0px; font-size: 13px;&quot;&gt;&lt;span style=&quot;background-color: initial; font-weight: normal;&quot;&gt;API&lt;/span&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;Post API&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;get all posts/ post by id:&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;GET&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /api/v1/post/{posyId}&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;create a new post:&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;POST&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /api/v1/post&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;Newfeed API&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;get new feed(infinite scolling):&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;GET&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;/api/v1/newfeed&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;Follow API&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;follow a user:&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;POST&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /api/v1/follow&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;get follower list:&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;GET&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;/api/v1/follow&lt;/span&gt;/{userId}&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;glass=0;shadow=1;verticalAlign=top;spacingTop=21;spacingLeft=14;fontSize=13;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="290" height="310" as="geometry" />
        </mxCell>
        <mxCell id="L3YlKu59HzU1ORrmf3q_-2" value="&lt;h1 style=&quot;margin-top: 0px; font-size: 13px;&quot;&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;Metrix&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; font-size: 13px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;total users: 1B&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; font-size: 13px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;Around&amp;nbsp;&lt;span data-end=&quot;120&quot; data-start=&quot;86&quot;&gt;100 million daily active users&lt;br&gt;each user posts 1 post/day&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; font-size: 13px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;span data-end=&quot;120&quot; data-start=&quot;86&quot;&gt;- each user consumes 100 posts/day&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; font-size: 13px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;span data-end=&quot;120&quot; data-start=&quot;86&quot;&gt;- average post size: 1 KB text + 100 KB media&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px; font-size: 13px;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;span data-end=&quot;120&quot; data-start=&quot;86&quot;&gt;- at peak traffic is 10x normal&lt;/span&gt;&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;span data-end=&quot;120&quot; data-start=&quot;86&quot;&gt;-&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;1 user can follow 1000 ones&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;DAU = 100 M&lt;/div&gt;&lt;div&gt;QPS:&lt;/div&gt;&lt;div&gt;write request/day = 100M&lt;/div&gt;&lt;div&gt;write request/s = 100M/(24*60*60) = 1156 req/s&lt;/div&gt;&lt;div&gt;write request at peak =&amp;nbsp; ~12K req/s&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;read request/day = 100M*100 = 10B&lt;/div&gt;&lt;div&gt;read request/s = 10B/(24*60*60) = ~100K req/s&lt;/div&gt;&lt;div&gt;read request at peak = 100K * 10 = 1M req/s&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;media storage(s3, ...)&lt;/div&gt;&lt;div&gt;storage growth/day&lt;/div&gt;&lt;div&gt;100KB * 100M = 10TB&lt;/div&gt;&lt;div&gt;5 years storage&lt;/div&gt;&lt;div&gt;10TB * 5*365 = 19PB&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;DB&lt;/div&gt;&lt;div&gt;&lt;div&gt;growth/day&lt;/div&gt;&lt;div&gt;2KB * 100M = 200GB&lt;/div&gt;&lt;/div&gt;&lt;div&gt;5 years&lt;/div&gt;&lt;div&gt;200GB * 5*356 = 365TB&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Hot cache = Daily storage × 60 days Hot cache = 200GB × 60 = 12 TB&amp;nbsp;&lt;/div&gt;&lt;div&gt;graph DB:&lt;br&gt;1B*1000*8bytes = 8TB&lt;/div&gt;&lt;div&gt;meta data:&lt;/div&gt;&lt;div&gt;1B * 2KB = 2TB&lt;/div&gt;&lt;div&gt;Indexing:&lt;br&gt;365TB*30% = ~120TB&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;glass=0;shadow=1;verticalAlign=top;spacingTop=21;spacingLeft=14;fontSize=13;align=left;" vertex="1" parent="1">
